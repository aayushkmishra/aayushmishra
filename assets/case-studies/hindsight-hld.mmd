%% Hindsight — high level design
%%
%% To use in draw.io:
%%   Arrange  ->  Insert  ->  Advanced  ->  Mermaid
%%   paste this whole file, Insert.
%% Then turn on the sketch look to match the other case studies:
%%   Format panel -> Style -> tick "Sketch"
%%   Extras -> Edit Diagram if you want to nudge the group boxes.
%% Export the loop as:
%%   File -> Export as -> GIF...  (tick "Animated", ~1200px wide)
%% Save the result as assets/case-studies/hindsight-hld.gif
%%
%% Palette below matches the existing HLDs:
%%   blue   #6C8EBF  normal step
%%   green  #82B366  the safety-critical step
%%   orange #D79B00  storage
%%   purple #9673A6  the questions you can ask

flowchart LR

    subgraph AGENT["Your agent"]
        direction TB
        A1["Model calls<br/><small>prompts and replies</small>"]
        A2["Tool results<br/><small>what the world said</small>"]
        A3["Retrieval and clock<br/><small>anything unpredictable</small>"]
    end

    subgraph REC["Recorder"]
        direction TB
        R1["Strip secrets<br/><small>before anything is kept</small>"]
        R2["Seal and chain<br/><small>tamper evident</small>"]
    end

    subgraph LOG["The record"]
        direction TB
        L1[("Append-only log<br/><small>nothing overwrites</small>")]
        L2[("Large payloads<br/><small>stored by content</small>")]
    end

    subgraph ASK["What you can ask"]
        direction TB
        Q1["What if we change the model?"]
        Q2["Did behaviour drift?"]
        Q3["How is it doing right now?"]
        Q4["Prove it to an auditor"]
    end

    A1 --> R1
    A2 -.-> R1
    A3 -.-> R1
    R1 --> R2
    R2 --> L1
    R2 -.-> L2

    L1 --> Q1
    L1 -.-> Q2
    L1 -.-> Q3
    L1 -.-> Q4

    classDef step  fill:#FFFFFF,stroke:#6C8EBF,stroke-width:1.6px,color:#33302B;
    classDef guard fill:#FFFFFF,stroke:#82B366,stroke-width:1.8px,color:#33302B;
    classDef store fill:#FFFFFF,stroke:#D79B00,stroke-width:1.6px,color:#33302B;
    classDef ask   fill:#FFFFFF,stroke:#9673A6,stroke-width:1.6px,color:#33302B;

    class A1,A2,A3,R2 step;
    class R1 guard;
    class L1,L2 store;
    class Q1,Q2,Q3,Q4 ask;
